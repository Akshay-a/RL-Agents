{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Journal Entry Schema",
  "description": "Schema for double-entry accounting journal entries",
  "type": "object",
  "required": ["date", "description", "entries"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date format (YYYY-MM-DD)"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Brief description of the transaction"
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "description": "Array of debit and credit entries",
      "items": {
        "type": "object",
        "required": ["account_code", "account_name", "debit", "credit"],
        "properties": {
          "account_code": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "description": "4-digit account code"
          },
          "account_name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable account name"
          },
          "debit": {
            "type": "number",
            "minimum": 0,
            "description": "Debit amount (0 if credit entry)"
          },
          "credit": {
            "type": "number",
            "minimum": 0,
            "description": "Credit amount (0 if debit entry)"
          },
          "memo": {
            "type": "string",
            "description": "Optional memo for this line item"
          }
        },
        "additionalProperties": false
      }
    },
    "reference": {
      "type": "string",
      "description": "Optional reference number or ID"
    }
  },
  "additionalProperties": false
}
